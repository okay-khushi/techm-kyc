# Copy this file to .env and fill in local values.
# NEVER commit the real .env file. NEVER put real secrets in this file.

# --- Application ---
APP_ENV=development
APP_NAME=Continuous KYC Autonomous Auditor
API_V1_PREFIX=/api/v1
LOG_LEVEL=

# NOTE: Phase 1 requires ONLY the three APP_* / API_ values above (all have
# safe defaults, so the app starts with an empty .env). Everything below is a
# placeholder for later phases / other workstreams — never put real secrets in
# this example file.

# --- KYC ingestion (Phase 2; non-secret, all have safe defaults) ---
KYC_RAW_DIR=data/raw/kyc
KYC_PROCESSED_DIR=data/processed
MAX_KYC_FILE_SIZE_MB=50

# --- Privacy (Phase 3) ---
# SECRET in real deployments. Leave BLANK here — never commit a real value.
# Empty => a clearly-insecure local dev fallback is used for pseudonymization.
PSEUDONYMIZATION_KEY=

# --- API ingestion (Phase 5; non-secret; safe defaults) ---
API_CONNECT_TIMEOUT_SECONDS=5
API_READ_TIMEOUT_SECONDS=10
MAX_API_RESPONSE_SIZE_MB=10
API_MAX_RETRIES=2
# Trusted OUTBOUND API sources as a JSON array. Server-controlled; callers only
# pick a source_id. NEVER put secret values here — reference them by logical
# name via auth_secret_name (resolved from the environment / future vault).
# Example (single line):
# [{"source_id":"kyc_provider","base_url":"https://api.example.com","endpoint_path":"/v1/kyc","http_method":"GET","auth_type":"bearer_token","auth_secret_name":"KYC_PROVIDER_API_TOKEN","payload_location":"data_field","data_field":"data","field_mapping":{"customerId":"client_id","fullName":"client_name","kind":"client_type","iso":"country","industry":"sector","risk":"sector_risk","pep":"pep_flag","sanctioned":"sanctions_flag","fatf":"fatf_country_flag"}}]
API_SOURCES_JSON=
# The referenced secret itself (example logical name). SECRET — leave blank here.
KYC_PROVIDER_API_TOKEN=

# --- Encryption at rest (Phase 6) ---
# Non-secret identifier stored in encrypted envelopes (enables future key
# rotation). Safe to keep this default.
ENCRYPTION_KEY_ID=kyc-data-key-v1
# SECRET. Leave BLANK here — never commit a real value. Must be set via the
# environment (or a local, git-ignored .env) to an environment-variable NAME
# EQUAL TO ENCRYPTION_KEY_ID's value, holding base64-encoded 32 random bytes.
# Generate one locally (never commit the output):
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Then, e.g. if ENCRYPTION_KEY_ID=kyc-data-key-v1:
#   kyc-data-key-v1=<paste-the-generated-value>
# Encryption/decryption fail safely with a configuration error until this is
# set; the app (incl. the public health endpoint) starts fine without it.

# --- TLS in transit (Phase 7) — non-secret paths/port only ---
# Strict LOCAL TLS 1.3 secure-demonstration listener (separate from the
# ordinary plain-HTTP dev server on 8000). Generate a local cert first:
#   pwsh scripts/setup/generate-dev-tls-cert.ps1
# then run:  python deployment/run_https_dev.py  ->  https://localhost:8443
TLS_CERT_FILE=certs/local/dev-cert.pem
TLS_KEY_FILE=certs/local/dev-key.pem
TLS_PORT=8443
# Trusted reverse-proxy IP(s)/CIDR allowed to set X-Forwarded-*. Leave BLANK
# (default) unless deployed behind a specific known proxy. NEVER "*".
TRUSTED_PROXY_IPS=

# --- Secrets provider selection (Phase 8) ---
# "environment" (default) = local-development SecretProvider (os.environ,
# same as Phases 5-6 already use). "vault" = HashiCorp Vault KV v2. Vault mode
# is explicit and fails closed — it NEVER silently falls back to environment.
SECRETS_PROVIDER=environment

# --- HashiCorp Vault connection (Phase 8) — NON-SECRET config only ---
# Local dev-mode Vault only; see docs/secrets-vault.md for production guidance.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_MOUNT_POINT=secret
VAULT_SECRET_PATH=continuous-kyc
VAULT_AUTH_METHOD=token
# VAULT_TOKEN is the bootstrap credential that authenticates THIS app to
# Vault. It is intentionally NOT read via pydantic-settings/.env — set it as a
# real process environment variable only (see docs/secrets-vault.md). NEVER a
# real value here; NEVER commit a real token.
# VAULT_TOKEN=<local-dev-only-set-via-process-environment-not-here>

# --- Audit logging (Phase 9) — non-secret configuration only ---
# Master on/off switch. When false, audit events are still built/sanitized
# in-process but nothing is persisted (a no-op sink is used).
AUDIT_ENABLED=true
# "jsonl" (default, local hash-chained file) | "memory" (process-local; used
# automatically by the test suite) | "null" (explicit no-op). An invalid
# value disables audit writes with a warning rather than crashing the app —
# see docs/audit-logging.md "Sink failure policy".
AUDIT_SINK=jsonl
# Server-controlled only. Relative paths are anchored at the repo root and
# MUST resolve inside backend/var/audit/ (git-ignored, never committed) —
# anything else falls back to the approved default path.
AUDIT_LOG_PATH=backend/var/audit/audit.jsonl

# --- Database ---
DATABASE_URL=

# --- Auth / JWT (Phase 4) ---
# JWT_SECRET_KEY: SECRET. Leave BLANK here. Set a strong (>=32 byte) value via
# the environment locally. Empty => /auth endpoints return "not configured".
# Generate one with, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# DEVELOPMENT-ONLY demo identities (JSON array). NEVER real credentials; the
# password_hash is an Argon2id hash you generate locally, not a plaintext. Empty
# => no demo users (default-deny). Tests do NOT use this.
# Example (single line): [{"username":"demo","principal_id":"U-DEMO","password_hash":"$argon2id$...","principal_type":"user","roles":["compliance_analyst"],"is_active":true}]
DEV_AUTH_USERS=

# --- LLM Provider (abstraction layer) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- External Integrations ---
NEWS_API_KEY=
SANCTIONS_DATA_SOURCE_URL=
OFAC_DATA_SOURCE_URL=

# --- Frontend ---
VITE_API_BASE_URL=
