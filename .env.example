APP_NAME="AI Engine"

# LLM Provider: "groq" or "google"
LLM_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional: if set, RAG retrieval (vector_search, gdpr_lookup,
# policy_lookup) embeds via NVIDIA NIM instead of the local
# sentence-transformers model.
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Optional: if set, all /api/v1 routes require this value in the
# X-API-Key header.
API_KEY=
